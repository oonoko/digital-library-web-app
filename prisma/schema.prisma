generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  icon  String
  count Int    @default(0)
  books Book[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Book {
  id          String   @id @default(cuid())
  title       String
  author      String
  cover       String
  description String
  pages       Int
  likes       Int      @default(0)
  rating      Float    @default(0)
  content     String[] 

  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
